run = "python -m http.server 5000 --bind 0.0.0.0"
entrypoint = "index.html"
hidden = [".config"]
modules = ["nodejs-18", "web", "python-3.11"]

[nix]
channel = "stable-23_05"

[deployment]
deploymentTarget = "static"
publicDir = "."

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000

[rules]

[rules.formatter]

[rules.formatter.fileExtensions]

[rules.formatter.fileExtensions.".html"]
id = "module:web/languageServer:html"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Web Server"

[[workflows.workflow]]
name = "Web Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m http.server 5000 --bind 0.0.0.0"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
